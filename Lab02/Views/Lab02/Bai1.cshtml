@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bài 1 - Table</title>
    <style>
        table.mytable {
            border: 3px solid black;
            border-collapse: collapse;
        }

        th.mytable {
            border: 1px solid dashed;
            background-color: black;
            font-weight: bold;
            color: white;
        }

        td.mytable {
            border: 1px solid dashed;
            text-align: center;
            color: white;
        }

        .mytable_row1 {
            background-color: lightseagreen;
            text-align: center;
            color: white;
        }

        .mytable_row2 {
            background-color: darkblue;
            text-align: center;
            color: white;
        }

    </style>
</head>
<body>
    <table class="mytable">
        <tr>
            <th class="mytable" width="150">header1</th>
            <th class="mytable" width="150">header2</th>
            <th class="mytable" width="150">header3</th>
            <th class="mytable" width="150">header4</th>
        </tr>

        <tr>
            <td class="mytable_row2">colum1</td>
            <td class="mytable_row1">colum2</td>
            <td class="mytable_row1">colum3</td>
            <td class="mytable_row1">colum4</td>
        </tr>

        <tr>
            <td class="mytable_row2">colum1</td>
            <td class="mytable_row1">colum2</td>
            <td class="mytable_row1">colum3</td>
            <td class="mytable_row1">colum4</td>
        </tr>

        <tr>
            <td class="mytable_row2">colum1</td>
            <td class="mytable_row1">colum2</td>
            <td class="mytable_row1">colum3</td>
            <td class="mytable_row1">colum4</td>
        </tr>

        <tr>
            <td class="mytable_row2">colum1</td>
            <td class="mytable_row1">colum2</td>
            <td class="mytable_row1">colum3</td>
            <td class="mytable_row1">colum4</td>
        </tr>
    </table>
</body>
</html>
